# Database
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
PORT=3000

# Initial one-workspace Admin account.
# The server creates this account only when app_users is empty.
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_NAME=Insight Hub Admin
AUTH_ADMIN_PASSWORD=replace-with-at-least-12-characters

# Optional secure-access tuning.
AUTH_COOKIE_NAME=insight_hub_session
AUTH_SESSION_DAYS=7
AUTH_INVITE_HOURS=72
PUBLIC_APP_URL=https://your-insight-hub.onrender.com

# Optional additional browser origins, comma-separated.
# Same-origin requests are always allowed. Leave blank for a standard Render deployment.
CORS_ALLOWED_ORIGINS=

# Existing provider keys remain server-side only. Never use VITE_ for private keys.
SAM_GOV_API_KEY=
SAM_API_KEY=
BLS_API_KEY=
ONET_API_KEY=
COURTLISTENER_API_TOKEN=
SEC_USER_AGENT=
